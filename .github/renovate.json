{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "local>reactiveui/.github:renovate"
    ],
    "packageRules": [
        {
            "description": "Keep the Application Insights 2.x adapter below version 3. The separate V3 adapter uses its own VersionOverride.",
            "matchCurrentVersion": "/^2\\./",
            "allowedVersions": "<3.0.0",
            "matchPackageNames": [
                "Microsoft.ApplicationInsights"
            ]
        }
    ]
}
